# Copier en .env.local et compléter. Toutes les valeurs sont optionnelles (réglables dans l'UI).
# Cible du proxy de dev /breign-api
BREIGN_API_TARGET=https://api.breign.eu
# URL de l'API vue par le navigateur (par défaut le proxy local)
VITE_BREIGN_API_URL=/breign-api
# Client OAuth de « Se connecter avec Breign » (par défaut breign-cli, le client de la CLI)
VITE_BREIGN_OAUTH_CLIENT_ID=
# Facultatif : clé API fixe, à la place de la connexion.
# ⚠ Une clé mise ici est embarquée dans le bundle : à réserver au développement local.
VITE_BREIGN_API_KEY=
VITE_BREIGN_AGENT_ID=
VITE_BREIGN_APP_ID=
VITE_BREIGN_LANG=fr
# Instance de l'application (une par appareil ou onglet : une seule socket par instance).
# Vide : l'instance par défaut de l'app.
VITE_BREIGN_INSTANCE_ID=
VITE_AVATAR_MODEL_URL=
